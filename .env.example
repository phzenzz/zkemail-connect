# relayer(本地进程,npm run relayer:run;真实值放根 .env,已 gitignore 则确认)
RELAYER_EMAIL=penghe1996@gmail.com
RELAYER_X25519_SECRET_HEX=<32 bytes hex>
# Gmail 认证二选一,按优先级取第一种已配置的:
# 1) OAuth2(推荐;账号无法创建应用专用密码时用):先运行 `npm run gmail:oauth-setup` 获取 refresh token
GMAIL_OAUTH_CLIENT_ID=<google cloud desktop oauth client id>
GMAIL_OAUTH_CLIENT_SECRET=<google cloud desktop oauth client secret>
GMAIL_OAUTH_REFRESH_TOKEN=<gmail-oauth-setup 脚本输出>
# 2) 应用专用密码(备选;需 Google 账号开启两步验证并支持创建 app password)
GMAIL_APP_PASSWORD=<gmail 16 位 app password>
RPC_URL=https://api.devnet.solana.com
PROVER_URL=http://localhost:8080
CLAIM_BASE_URL=http://localhost:5173/claim/
RELAYER_KEYPAIR_PATH=~/.config/solana/id.json
