# relayer 配置模板。复制为 .env（已 gitignore）后填写。
# 加载方式（Node 20.6+ 原生 --env-file，链式加载、后者优先）：
#   npm run relayer            # 仅 .env
#   npm run relayer:local      # .env + .env.local（本地 validator）
#   npm run relayer:devnet     # .env + .env.devnet（devnet）
# 脱敏核对生效值：npm run relayer:print-config（或 :print-config:local）
# 缺必需项时启动即报清单式错误（fail-fast）。

# ===== 必需 =====
# relayer 身份 = 邮箱（链上 relayer_email_hash 的 preimage；证明亦绑定其 Poseidon）。
# 必须等于测试/生产邮件的 To 地址。
RELAYER_EMAIL=penghe1996@gmail.com
# x25519 私钥 hex（64 字符 = 32 字节），与链上 relayerEntry.x25519Key 的公钥对应。
# 手动测试流程由 e2e/manual/04-registry.ts 生成并存入 .manual-test/state.json 的 relayerX25519Secret。
RELAYER_X25519_SECRET_HEX=<32 bytes hex>

# ===== 链与基础设施（有默认值，可覆盖）=====
RPC_URL=https://api.devnet.solana.com
PROVER_URL=http://localhost:8080
CLAIM_BASE_URL=http://localhost:5173/claim/
# 代付/出证 relayer 的 Solana 密钥对（proof 绑定该公钥；必须与出证明时用的是同一把）
RELAYER_KEYPAIR_PATH=~/.config/solana/id.json

# ===== Gmail 凭证（通知 + 收回复邮件；二选一，OAuth2 优先；均未配则通知降级 Console、inbound 不启动）=====
# 1) OAuth2（账号无法创建应用专用密码时用）：`npm run gmail:oauth-setup` 获取 refresh token
GMAIL_OAUTH_CLIENT_ID=<google cloud desktop oauth client id>
GMAIL_OAUTH_CLIENT_SECRET=<google cloud desktop oauth client secret>
GMAIL_OAUTH_REFRESH_TOKEN=<gmail-oauth-setup 脚本输出>
# 2) 应用专用密码（备选；需两步验证）
GMAIL_APP_PASSWORD=<gmail 16 位 app password>
